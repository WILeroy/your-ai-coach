# LLM API 配置 (OpenAI 兼容接口)
# 推荐: https://platform.deepseek.com (DeepSeek) 或 https://platform.moonshot.cn (Kimi)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2

# Agent 配置
AGENT_MAX_TOOL_ROUNDS=10
CHAT_HISTORY_LIMIT=20

# 访问口令（登录 Web 用，务必修改为自己的强口令）
ACCESS_PASSWORD=change-me-please

# 部署安全（nginx HTTPS 反代时使用）
# COOKIE_SECURE=true            # 启用后会话Cookie仅经HTTPS传输
# TRUSTED_PROXIES=127.0.0.1,::1 # 只有这些来源的请求才信任X-Forwarded-For

# 联网搜索 (默认免注册多引擎: 搜狗→360→必应；如日后反爬失效可填Key切商业API)
SEARCH_PROVIDER=bing
SEARCH_API_KEY=
